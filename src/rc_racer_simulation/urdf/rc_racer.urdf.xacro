<?xml version="1.0"?>
<!-- SPDX-FileCopyrightText: 2025 Anthony Tracy -->
<!-- SPDX-License-Identifier: MIT -->
<!--
  RC Racer Robot Description
  
  Based on Traxxas Slash specifications from documentation/Rc-Car-Design.md:
  - Wheelbase: 384 mm
  - Wheel Diameter: 67.4 mm  
  - Wheel Width: 28.5 mm
-->
<robot name="rc_racer" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Tyre-ground friction coefficient. The ground plane is left at the SDF
       default (1.0) and Gazebo uses the lower of the two, so this sets the
       grip: 0.5 = dirt / dry grass (worst case of the usual RoboMagellan
       surfaces), ~0.8 = dry pavement, ~0.3 = wet grass. Only the rear
       wheels drive, so grip caps the acceleration at about 3.3 * tire_mu
       m/s^2 (measured: 1.7 at 0.5, 0.6 at 0.2). Below ~0.9 a full-throttle
       launch (the drive's 3 m/s^2 limit) spins the rear wheels. -->
  <xacro:arg name="tire_mu" default="0.5"/>
  <xacro:property name="tire_mu" value="$(arg tire_mu)"/>

  <!-- Include component files -->
  <xacro:include filename="$(find rc_racer_simulation)/urdf/chassis.urdf.xacro"/>
  <xacro:include filename="$(find rc_racer_simulation)/urdf/wheels.urdf.xacro"/>
  <xacro:include filename="$(find rc_racer_simulation)/urdf/sensors.urdf.xacro"/>

  <!-- Robot Parameters (from Rc-Car-Design.md) -->
  <xacro:property name="wheelbase" value="0.384"/>
  <xacro:property name="track_width" value="0.30"/>
  <xacro:property name="wheel_radius" value="0.0337"/>
  <xacro:property name="wheel_width" value="0.0285"/>
  
  <!-- Chassis dimensions (approximate) -->
  <xacro:property name="chassis_length" value="0.50"/>
  <xacro:property name="chassis_width" value="0.25"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass" value="3.0"/>
  
  <!-- Ground clearance -->
  <xacro:property name="ground_clearance" value="0.05"/>

  <!-- Instantiate components -->
  <xacro:rc_racer_chassis/>
  <xacro:rc_racer_wheels/>
  <xacro:rc_racer_sensors/>

  <!-- Ground truth of the body's own motion (ICD-VEH-TST VEH-TST-08), stamped:
       pose and velocity of base_footprint, whatever the wheels do. The
       sensor adapter derives the IMU's acceleration from it (DEV-07). -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>body_odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

</robot>
