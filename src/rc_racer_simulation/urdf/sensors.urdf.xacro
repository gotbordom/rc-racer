<!--
  RC Racer Sensors - Gazebo Fortress

  Sensors are defined here but plugins are attached via ros_gz_bridge
  because Gazebo Fortress uses a different plugin architecture.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rc_racer_sensors">

    <!-- IMU link -->
    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.02 0.01"/>
        </geometry>
        <material name="green">
          <color rgba="0.0 0.8 0.0 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 ${chassis_height/2 + 0.01}" rpy="0 0 0"/>
    </joint>

    <!-- GPS link -->
    <link name="gps_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.02"/>
        </geometry>
        <material name="red">
          <color rgba="0.8 0.0 0.0 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="gps_joint" type="fixed">
      <parent link="base_link"/>
      <child link="gps_link"/>
      <origin xyz="-0.1 0 ${chassis_height/2 + 0.05}" rpy="0 0 0"/>
    </joint>

    <!-- Camera link -->
    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.08 0.03"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="${chassis_length/2 - 0.02} 0 ${chassis_height/2 + 0.02}" rpy="0 0.1 0"/>
    </joint>

    <!-- Camera optical frame (Z forward, X right, Y down) -->
    <link name="camera_optical_link"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_link"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- ============================================= -->
    <!-- Gazebo Fortress Sensor Definitions           -->
    <!-- Sensors are bridged to ROS via ros_gz_bridge -->
    <!-- ============================================= -->

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <ignition_frame_id>imu_link</ignition_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <gazebo reference="gps_link">
      <sensor name="navsat_sensor" type="navsat">
        <ignition_frame_id>gps_link</ignition_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>navsat</topic>
      </sensor>
    </gazebo>

    <gazebo reference="camera_link">
      <sensor name="camera_sensor" type="camera">
        <!-- Image data uses the optical convention (Z forward, X right, Y down) -->
        <ignition_frame_id>camera_optical_link</ignition_frame_id>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>camera</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
